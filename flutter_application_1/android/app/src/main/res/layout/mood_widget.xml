<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mood"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Emoji + Title + Check-in Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💛"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Mood Tracker"
            android:textColor="#5B4A8A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mood_checkin_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:backgroundTint="#9B8EC4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0 check-ins"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Large Mood Emoji -->
    <TextView
        android:id="@+id/mood_emoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤔"
        android:textSize="42sp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- Mood Label -->
    <TextView
        android:id="@+id/mood_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How are you?"
        android:textColor="#352E4A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <!-- Mood Description -->
    <TextView
        android:id="@+id/mood_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to check in"
        android:textColor="#7B6EA4"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 7-Day Mood Dots Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="3dp">

        <ImageView android:id="@+id/mood_dot_0" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_1" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_2" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_3" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_4" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_5" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
        <ImageView android:id="@+id/mood_dot_6" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/pill_bg" android:backgroundTint="#E0D6F0" />
    </LinearLayout>

    <!-- Day Labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="M" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="T" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="W" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="T" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="F" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="S" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="S" android:textColor="#9E8EC4" android:textSize="8sp" android:gravity="center" />
    </LinearLayout>

</LinearLayout>
